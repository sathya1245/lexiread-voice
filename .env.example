# ---------------------------------------------------------------------------
# LexiRead server configuration (all values are optional — the defaults work)
# ---------------------------------------------------------------------------

# Port the API + built client are served from.
PORT=8787
HOST=0.0.0.0

# Where the SQLite database lives. On a hosting platform, point this at a
# mounted disk or volume so profiles and progress survive redeploys.
DATA_DIR=./server/data

# Folder holding the built client (npm run build). Served by the API in
# production so the whole app runs as one service.
CLIENT_DIST=./client/dist

# Comma separated allowed origins, or * for any (fine for a local demo).
CORS_ORIGIN=*

# OCR languages for tesseract.js. Multiple languages use '+', e.g. eng+hin.
# This is the hook for future multilingual (Indic) support.
OCR_LANGS=eng

# A PDF page with fewer characters than this is treated as a scan and OCR'd.
PDF_SCAN_CHARS_PER_PAGE=10

# Upload size limit in bytes (15 MB).
MAX_UPLOAD_BYTES=15728640

# Dictionary API timeout. The free dictionary is optional: LexiRead falls back
# to its built-in school vocabulary and a circuit breaker after two failures.
DICTIONARY_TIMEOUT_MS=6000

# How long a QR handoff code stays valid (6 hours).
HANDOFF_TTL_MS=21600000

# Set to 0 to require an account before uploading or reading.
ALLOW_ANONYMOUS=1

NODE_ENV=production

{
  "name": "lexiread",
  "version": "1.0.0",
  "private": true,
  "description": "LexiRead — an assistive learning platform for students with dyslexia: dyslexia-friendly reading, voice-following guided reading, listening and writing support.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "node server/src/index.js",
    "test": "node --test \"shared/test/*.test.js\" \"server/test/*.test.js\""
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
